NODE_ENV=development
PORT=4000
# Locally installed PostgreSQL on 5432. Create the role + database once:
#   CREATE ROLE qudrat LOGIN PASSWORD 'qudrat';
#   CREATE DATABASE qudrat_lms OWNER qudrat;
# Using the Docker Postgres instead (npm run db:up)? That listens on 5433.
DATABASE_URL="postgresql://qudrat:qudrat@localhost:5432/qudrat_lms?schema=public"
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
UPLOAD_DIR="./uploads"
